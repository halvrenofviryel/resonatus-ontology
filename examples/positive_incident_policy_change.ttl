@prefix res: <https://w3id.org/resonatus#> .
@prefix ex: <https://example.org/resonatus/case/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:incident_policy_change a res:ResonatusCandidate ; rdfs:label "Organizational incident trace transformed into later policy" ; res:expectedClassification "MEMBERSHIP_SUPPORTED" .
ex:incident_policy_change_assessment a res:ResonatusAssessment ; res:assesses ex:incident_policy_change ;
  res:hasCriterionAssessment ex:incident_policy_change_c1, ex:incident_policy_change_c2, ex:incident_policy_change_c3, ex:incident_policy_change_c4, ex:incident_policy_change_c5 .

ex:incident_policy_change_c1 a res:CriterionAssessment ; res:criterion res:TraceCriterion ; res:verdict res:PASS .
ex:incident_policy_change_c2 a res:CriterionAssessment ; res:criterion res:DelayCriterion ; res:verdict res:PASS .
ex:incident_policy_change_c3 a res:CriterionAssessment ; res:criterion res:PropagationCriterion ; res:verdict res:PASS .
ex:incident_policy_change_c4 a res:CriterionAssessment ; res:criterion res:SelectivityCriterion ; res:verdict res:PASS .
ex:incident_policy_change_c5 a res:CriterionAssessment ; res:criterion res:TransformationFeedbackCriterion ; res:verdict res:PASS .

# Incident consequences persist, propagate across organizational states, are context-sensitive, and are transformed into a later governance response.

# --- ontic path: witness present iff its criterion verdict is PASS;
# canonical origin/receiver coherence. OWL entails Resonatus iff all five present (all PASS).
@prefix exp: <https://example.org/resonatus/case/> .
ex:incident_policy_change_origin a res:Interaction .
ex:incident_policy_change_recv a res:ReceiverContext .
ex:incident_policy_change_trace a res:TraceContinuation ; res:causallyAttributedTo ex:incident_policy_change_origin .
ex:incident_policy_change_delay a res:PostInteractionContinuation ; res:postInteractionOf ex:incident_policy_change_origin .
ex:incident_policy_change_prop a res:PropagationEvent ; res:hasPropagationReceiver ex:incident_policy_change_recv .
ex:incident_policy_change_sel a res:ContextModulation ; res:uptakeDependsOn ex:incident_policy_change_recv .
ex:incident_policy_change_tf a res:TransformationEvent .
ex:incident_policy_change_path a res:ContinuationPath ;
  res:hasDeclaredOriginInteraction ex:incident_policy_change_origin ;
  res:hasTraceContinuation ex:incident_policy_change_trace ;
  res:hasPostInteractionContinuation ex:incident_policy_change_delay ;
  res:hasPropagationEvent ex:incident_policy_change_prop ;
  res:hasContextModulation ex:incident_policy_change_sel ;
  res:hasTransformationEvent ex:incident_policy_change_tf .
ex:incident_policy_change res:hasTracePath ex:incident_policy_change_path .
ex:incident_policy_change_assessment res:assessesPath ex:incident_policy_change_path .
