@prefix res: <https://w3id.org/resonatus#> .
@prefix ex: <https://example.org/resonatus/case/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .

ex:no_transform_feedback a res:ResonatusCandidate ; rdfs:label "Delayed selective propagated trace neither changes form nor enters a feedback loop" ; res:expectedClassification "NON_MEMBERSHIP_SUPPORTED" .
ex:no_transform_feedback_assessment a res:ResonatusAssessment ; res:assesses ex:no_transform_feedback ;
  res:hasCriterionAssessment ex:no_transform_feedback_c1, ex:no_transform_feedback_c2, ex:no_transform_feedback_c3, ex:no_transform_feedback_c4, ex:no_transform_feedback_c5 .

ex:no_transform_feedback_c1 a res:CriterionAssessment ; res:criterion res:TraceCriterion ; res:verdict res:PASS .
ex:no_transform_feedback_c2 a res:CriterionAssessment ; res:criterion res:DelayCriterion ; res:verdict res:PASS .
ex:no_transform_feedback_c3 a res:CriterionAssessment ; res:criterion res:PropagationCriterion ; res:verdict res:PASS .
ex:no_transform_feedback_c4 a res:CriterionAssessment ; res:criterion res:SelectivityCriterion ; res:verdict res:PASS .
ex:no_transform_feedback_c5 a res:CriterionAssessment ; res:criterion res:TransformationFeedbackCriterion ; res:verdict res:FAIL .

# Counterexample isolates failure of Transformation/Feedback.

# --- ontic path: witness present iff its criterion verdict is PASS;
# canonical origin/receiver coherence. OWL entails Resonatus iff all five present (all PASS).
@prefix exp: <https://example.org/resonatus/case/> .
ex:no_transform_feedback_origin a res:Interaction .
ex:no_transform_feedback_recv a res:ReceiverContext .
ex:no_transform_feedback_trace a res:TraceContinuation ; res:causallyAttributedTo ex:no_transform_feedback_origin .
ex:no_transform_feedback_delay a res:PostInteractionContinuation ; res:postInteractionOf ex:no_transform_feedback_origin .
ex:no_transform_feedback_prop a res:PropagationEvent ; res:hasPropagationReceiver ex:no_transform_feedback_recv .
ex:no_transform_feedback_sel a res:ContextModulation ; res:uptakeDependsOn ex:no_transform_feedback_recv .
ex:no_transform_feedback_path a res:ContinuationPath ;
  res:hasDeclaredOriginInteraction ex:no_transform_feedback_origin ;
  res:hasTraceContinuation ex:no_transform_feedback_trace ;
  res:hasPostInteractionContinuation ex:no_transform_feedback_delay ;
  res:hasPropagationEvent ex:no_transform_feedback_prop ;
  res:hasContextModulation ex:no_transform_feedback_sel .
ex:no_transform_feedback res:hasTracePath ex:no_transform_feedback_path .
ex:no_transform_feedback_assessment res:assessesPath ex:no_transform_feedback_path .
