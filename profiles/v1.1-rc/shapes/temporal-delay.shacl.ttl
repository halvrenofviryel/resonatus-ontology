@prefix strict: <https://w3id.org/resonatus/strict#> .
@prefix res: <https://w3id.org/resonatus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix time: <http://www.w3.org/2006/time#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# RC temporal profile: canonical UTC second precision at the data boundary; value-based dateTime
# comparison inside SPARQL. Delay remains separate from the causal spine and may overlap its origin.
strict:TemporalDelayShape a sh:NodeShape ;
  sh:targetClass res:PostInteractionContinuation ;
  sh:targetObjectsOf res:hasPostInteractionContinuation ;
  sh:property [ sh:path res:postInteractionOf ; sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_DATA: the Delay witness needs an origin reference." ] ;
  sh:property [ sh:path res:postInteractionOf ; sh:maxCount 1 ; sh:class res:Interaction ;
    sh:message "VIOLATION_TEMPORAL_ORIGIN: the Delay witness must reference exactly one Interaction." ] ;
  sh:property [ sh:path strict:temporallyQualifiesPath ; sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_LINEAGE_LINK: the Delay witness must identify the ContinuationPath it temporally qualifies." ] ;
  sh:property [ sh:path strict:temporallyQualifiesPath ; sh:maxCount 1 ;
    sh:message "VIOLATION_TEMPORAL_LINEAGE_CARDINALITY: the Delay witness must qualify exactly one ContinuationPath." ] ;
  sh:property [ sh:path strict:temporallyQualifiesPath ; sh:class res:ContinuationPath ;
    sh:message "VIOLATION_TEMPORAL_LINEAGE_TYPE: the temporal qualification target must be a ContinuationPath." ] ;
  sh:property [ sh:path res:hasTemporalExtent ; sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_DATA: the Delay witness needs an interval." ] ;
  sh:property [ sh:path res:hasTemporalExtent ; sh:maxCount 1 ; sh:class time:ProperInterval ;
    sh:message "VIOLATION_TEMPORAL_INTERVAL: the Delay witness must have exactly one ProperInterval." ] ;
  sh:property [
    sh:path (res:hasTemporalExtent time:hasBeginning time:inXSDDateTimeStamp) ;
    sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_DATA: the Delay interval needs a beginning timestamp."
  ] ;
  sh:property [
    sh:path (res:hasTemporalExtent time:hasBeginning time:inXSDDateTimeStamp) ;
    sh:maxCount 1 ; sh:datatype xsd:dateTimeStamp ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ;
    sh:message "VIOLATION_TEMPORAL_TIMESTAMP: the Delay beginning must be one canonical UTC-second xsd:dateTimeStamp."
  ] ;
  sh:property [
    sh:path (res:hasTemporalExtent time:hasEnd time:inXSDDateTimeStamp) ;
    sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_DATA: the Delay interval needs an end timestamp."
  ] ;
  sh:property [
    sh:path (res:hasTemporalExtent time:hasEnd time:inXSDDateTimeStamp) ;
    sh:maxCount 1 ; sh:datatype xsd:dateTimeStamp ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ;
    sh:message "VIOLATION_TEMPORAL_TIMESTAMP: the Delay end must be one canonical UTC-second xsd:dateTimeStamp."
  ] ;
  sh:property [
    sh:path (res:postInteractionOf res:hasTemporalExtent time:hasEnd time:inXSDDateTimeStamp) ;
    sh:minCount 1 ;
    sh:message "MISSING_TEMPORAL_DATA: the origin needs an interval end timestamp."
  ] ;
  sh:property [
    sh:path (res:postInteractionOf res:hasTemporalExtent time:hasEnd time:inXSDDateTimeStamp) ;
    sh:maxCount 1 ; sh:datatype xsd:dateTimeStamp ;
    sh:pattern "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" ;
    sh:message "VIOLATION_TEMPORAL_TIMESTAMP: the origin end must be one canonical UTC-second xsd:dateTimeStamp."
  ] ;
  sh:sparql [
    sh:message "MISSING_TEMPORAL_LINEAGE_LINK: the Delay witness must temporally qualify the path that carries it." ;
    sh:select """
      SELECT $this WHERE {
        ?path <https://w3id.org/resonatus#hasPostInteractionContinuation> $this .
        FILTER NOT EXISTS {
          $this <https://w3id.org/resonatus/strict#temporallyQualifiesPath> ?path .
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "VIOLATION_TEMPORAL_LINEAGE_MISMATCH: the Delay witness explicitly qualifies a different ContinuationPath from the path that carries it." ;
    sh:select """
      SELECT $this WHERE {
        ?path <https://w3id.org/resonatus#hasPostInteractionContinuation> $this .
        $this <https://w3id.org/resonatus/strict#temporallyQualifiesPath> ?otherPath .
        FILTER (?otherPath != ?path)
      }
    """
  ] ;
  sh:sparql [
    sh:message "VIOLATION_TEMPORAL_ORDER: continuation duration must be non-zero and its end must be strictly after the origin end." ;
    sh:select """
      PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
      SELECT $this WHERE {
        $this <https://w3id.org/resonatus#postInteractionOf> ?origin ;
              <https://w3id.org/resonatus#hasTemporalExtent> ?delayInterval .
        ?delayInterval <http://www.w3.org/2006/time#hasBeginning> ?delayBeginInstant ;
                       <http://www.w3.org/2006/time#hasEnd> ?delayEndInstant .
        ?delayBeginInstant <http://www.w3.org/2006/time#inXSDDateTimeStamp> ?delayBegin .
        ?delayEndInstant <http://www.w3.org/2006/time#inXSDDateTimeStamp> ?delayEnd .
        ?origin <https://w3id.org/resonatus#hasTemporalExtent> ?originInterval .
        ?originInterval <http://www.w3.org/2006/time#hasEnd> ?originEndInstant .
        ?originEndInstant <http://www.w3.org/2006/time#inXSDDateTimeStamp> ?originEnd .
        BIND(xsd:dateTime(STR(?delayBegin)) AS ?delayBeginValue)
        BIND(xsd:dateTime(STR(?delayEnd)) AS ?delayEndValue)
        BIND(xsd:dateTime(STR(?originEnd)) AS ?originEndValue)
        FILTER (?delayEndValue <= ?delayBeginValue || ?delayEndValue <= ?originEndValue)
      }
    """
  ] .
