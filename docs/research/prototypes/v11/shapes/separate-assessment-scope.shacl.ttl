@prefix exp: <https://w3id.org/resonatus/experimental/v1.1#> .
@prefix res: <https://w3id.org/resonatus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Experimental profile C. Every activated assessment has one distinct information object as its scope;
# that information object denotes the real ContinuationPath and is not the path itself.

exp:SeparateAssessmentScopeShape a sh:NodeShape ;
  sh:targetClass res:ResonatusAssessment ;
  sh:targetSubjectsOf res:assesses ;
  sh:property [
    sh:path res:assesses ; sh:minCount 1 ;
    sh:message "MISSING_SCOPE_DATA: an assessment needs an assessed candidate."
  ] ;
  sh:property [
    sh:path res:assesses ; sh:maxCount 1 ; sh:class res:ResonatusCandidate ;
    sh:message "VIOLATION_SCOPE_CARDINALITY: an assessment must assess exactly one candidate."
  ] ;
  sh:property [
    sh:path res:assessesPath ; sh:minCount 1 ;
    sh:message "MISSING_SCOPE_DATA: an assessment needs an assessed path."
  ] ;
  sh:property [
    sh:path res:assessesPath ; sh:maxCount 1 ; sh:class res:ContinuationPath ;
    sh:message "VIOLATION_SCOPE_CARDINALITY: an assessment must assess exactly one ContinuationPath."
  ] ;
  sh:property [
    sh:path exp:hasAssessmentScope ; sh:minCount 1 ;
    sh:message "MISSING_SCOPE_DATA: an assessment needs an AssessmentScope."
  ] ;
  sh:property [
    sh:path exp:hasAssessmentScope ; sh:maxCount 1 ; sh:class exp:AssessmentScope ;
    sh:message "VIOLATION_SCOPE_CARDINALITY: an assessment must have exactly one AssessmentScope."
  ] ;
  sh:sparql [
    sh:message "MISSING_SCOPE_DATA: the AssessmentScope must denote the assessed ContinuationPath." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/resonatus#assessesPath> ?path ;
              <https://w3id.org/resonatus/experimental/v1.1#hasAssessmentScope> ?scope .
        FILTER NOT EXISTS {
          ?scope <https://w3id.org/resonatus/experimental/v1.1#scopesProcess> ?path .
        }
      }
    """
  ] ;
  sh:sparql [
    sh:message "VIOLATION_SCOPE_IDENTITY: AssessmentScope, assessment, candidate, and process path must be distinct nodes." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/resonatus#assesses> ?candidate ;
              <https://w3id.org/resonatus#assessesPath> ?path ;
              <https://w3id.org/resonatus/experimental/v1.1#hasAssessmentScope> ?scope .
        FILTER (?scope IN ($this, ?candidate, ?path) || ?candidate = ?path || $this IN (?candidate, ?path))
      }
    """
  ] ;
  sh:sparql [
    sh:message "VIOLATION_SCOPE_CATEGORY: AssessmentScope must not be typed as ContinuationPath." ;
    sh:select """
      SELECT $this WHERE {
        $this <https://w3id.org/resonatus/experimental/v1.1#hasAssessmentScope> ?scope .
        ?scope a <https://w3id.org/resonatus#ContinuationPath> .
      }
    """
  ] .
