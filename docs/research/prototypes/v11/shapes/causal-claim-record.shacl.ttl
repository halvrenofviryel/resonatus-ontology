@prefix exp: <https://w3id.org/resonatus/experimental/v1.1#> .
@prefix res: <https://w3id.org/resonatus#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .

# Structural well-formedness of an epistemic claim record. A conforming record may still be an
# unaccepted hypothesis and does not assert an ontic causal relation.

exp:CausalClaimRecordShape a sh:NodeShape ;
  sh:targetClass exp:CausalAttributionClaim ;
  sh:targetSubjectsOf exp:causalSubject ;
  sh:property [
    sh:path exp:causalSubject ; sh:minCount 1 ;
    sh:message "MISSING_CLAIM_RECORD_DATA: a causal claim needs a subject."
  ] ;
  sh:property [
    sh:path exp:causalSubject ; sh:maxCount 1 ;
    sh:message "VIOLATION_CLAIM_RECORD_CARDINALITY: a causal claim must have exactly one subject."
  ] ;
  sh:property [
    sh:path exp:causalObject ; sh:minCount 1 ;
    sh:message "MISSING_CLAIM_RECORD_DATA: a causal claim needs an object."
  ] ;
  sh:property [
    sh:path exp:causalObject ; sh:maxCount 1 ;
    sh:message "VIOLATION_CLAIM_RECORD_CARDINALITY: a causal claim must have exactly one object."
  ] ;
  sh:property [
    sh:path exp:usesCausalAssessmentMethod ; sh:minCount 1 ;
    sh:message "MISSING_CLAIM_RECORD_DATA: a causal claim needs an assessment method."
  ] ;
  sh:property [
    sh:path exp:usesCausalAssessmentMethod ; sh:class res:AssessmentMethod ;
    sh:message "VIOLATION_CLAIM_RECORD_TYPE: the causal assessment method must be an AssessmentMethod."
  ] .
